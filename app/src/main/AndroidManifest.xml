<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Required for Custom Order voice notes -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_logo"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity
            android:name=".CartActivity"
            android:exported="true" />

        <activity
            android:name=".CheckoutActivity"
            android:exported="true" />

        <activity
            android:name=".AccountActivity"
            android:exported="true" />

        <activity
            android:name=".MusicPlayerActivity"
            android:exported="true" />

        <activity
            android:name=".HowToOrderActivity"
            android:exported="true" />

        <activity
            android:name=".MenuActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- Custom order + voice note screen -->
        <activity
            android:name=".CustomOrderActivity"
            android:exported="false" />

    </application>

</manifest>

After replacing it, don't build yet. We should first make sure "CustomOrderActivity.java" and "activity_custom_order.xml" are in the correct folders, then I'll take you to the next step.

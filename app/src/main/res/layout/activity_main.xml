<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream_light">

    <!-- PROFESSIONAL HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/header_gradient"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="20dp">

        <!-- LOGO STRETCHED FULL WIDTH -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:src="@drawable/ic_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Logo" />

        <!-- 3D TITLE EFFECT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IyaAdam Kitchen"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/gold"
            android:textAlignment="center"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.05"
            android:shadowColor="@color/black"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- TAGLINE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="For Delicious Food Experience"
            android:textSize="12sp"
            android:textColor="@color/cream_light"
            android:textAlignment="center"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.02" />

    </LinearLayout>

    <!-- PROMO BANNER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_margin="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20% OFF your first order"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/header_green" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use code: IYAADAM20"
            android:textSize="12sp"
            android:textColor="@color/header_green"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- DISHES RECYCLER -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dishes_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <!-- PROFESSIONAL FOOTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_green"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <!-- NAVIGATION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="8dp">
                <ImageButton
                    android:id="@+id/ic_home"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_rounded_gold"
                    android:scaleType="centerInside"
                    android:contentDescription="How to Order"
                    android:padding="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guide"
                    android:textSize="10sp"
                    android:textColor="@color/gold"
                    android:textAlignment="center"
                    android:layout_marginTop="3dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="8dp">
                <ImageButton
                    android:id="@+id/ic_search"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_rounded_gold"
                    android:scaleType="centerInside"
                    android:contentDescription="Search"
                    android:padding="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search"
                    android:textSize="10sp"
                    android:textColor="@color/gold"
                    android:textAlignment="center"
                    android:layout_marginTop="3dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="8dp">
                <ImageButton
                    android:id="@+id/ic_cart_nav"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_rounded_gold"
                    android:scaleType="centerInside"
                    android:contentDescription="Cart"
                    android:padding="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cart"
                    android:textSize="10sp"
                    android:textColor="@color/gold"
                    android:textAlignment="center"
                    android:layout_marginTop="3dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="8dp">
                <ImageButton
                    android:id="@+id/ic_orders"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_rounded_gold"
                    android:scaleType="centerInside"
                    android:contentDescription="Music"
                    android:padding="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Music"
                    android:textSize="10sp"
                    android:textColor="@color/gold"
                    android:textAlignment="center"
                    android:layout_marginTop="3dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="8dp">
                <ImageButton
                    android:id="@+id/ic_person"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_rounded_gold"
                    android:scaleType="centerInside"
                    android:contentDescription="Account"
                    android:padding="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account"
                    android:textSize="10sp"
                    android:textColor="@color/gold"
                    android:textAlignment="center"
                    android:layout_marginTop="3dp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- CREDIT LINE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✦ A creation of fdc: +2347089364492 ✦"
            android:textSize="9sp"
            android:textColor="@color/gold"
            android:textAlignment="center"
            android:paddingVertical="8dp"
            android:letterSpacing="0.03"
            android:fontFamily="@font/poppins_medium" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#06452F">

    <!-- PREMIUM HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#06452F"
        android:orientation="vertical"
        android:paddingVertical="16dp"
        android:paddingHorizontal="16dp">

        <!-- TOP ROW: TITLE + ICONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IyaAdam"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="@color/gold"
                android:fontFamily="serif"
                android:shadowColor="@color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="24sp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kitchen"
            android:textSize="16sp"
            android:textColor="@color/gold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />

        <!-- INSCRIPTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visit IyaAdam Kitchen @ Awokoya, Ijebu Ode\nfor delicious experience"
            android:textSize="11sp"
            android:textColor="@color/cream_light"
            android:textAlignment="center"
            android:lineSpacingExtra="2dp"
            android:letterSpacing="0.01" />
    </LinearLayout>

    <!-- RIBBON -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/alert_red" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white" />

    <!-- HERO -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:src="@drawable/images"
        android:scaleType="centerCrop" />

    <!-- RIBBON -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white" />
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/alert_red" />

    <!-- CATEGORIES -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#06452F"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="75dp"
                android:layout_height="70dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/card_curvy">
                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="45dp"
                    android:src="@drawable/images"
                    android:scaleType="centerCrop" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="African"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/header_green"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="75dp"
                android:layout_height="70dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/card_curvy">
                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="45dp"
                    android:src="@drawable/images8"
                    android:scaleType="centerCrop" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continental"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/header_green"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="75dp"
                android:layout_height="70dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/card_curvy">
                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="45dp"
                    android:src="@drawable/images10"
                    android:scaleType="centerCrop" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grills"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/header_green"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="75dp"
                android:layout_height="70dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/card_curvy">
                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="45dp"
                    android:src="@drawable/images11"
                    android:scaleType="centerCrop" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rice"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/header_green"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- RIBBON -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white" />
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/alert_red" />

    <!-- TITLE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="#06452F">
        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="@color/alert_red"
            android:layout_marginEnd="8dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Featured Dishes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/gold" />
    </LinearLayout>

    <!-- DISHES -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dishes_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:background="#06452F" />

    <!-- RIBBON -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/alert_red" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white" />

    <!-- FOOTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#06452F"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/ic_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Home"
            android:textSize="12sp"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/ic_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Menu"
            android:textSize="12sp"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/ic_cart_nav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cart"
            android:textSize="12sp"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/ic_orders"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Music"
            android:textSize="12sp"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/ic_person"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profile"
            android:textSize="12sp"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textAlignment="center" />

    </LinearLayout>

    <!-- CREDIT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#06452F"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp">

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:background="@color/alert_red"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="fdc: +2347089364492"
            android:textSize="10sp"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:background="@color/alert_red"
            android:layout_marginStart="12dp" />

    </LinearLayout>

</LinearLayout>

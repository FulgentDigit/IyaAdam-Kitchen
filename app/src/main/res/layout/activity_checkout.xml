<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#06452F"
    android:padding="16dp">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/header_green"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💳 Checkout"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/gold"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- DELIVERY INFORMATION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 Delivery Information"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/gold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/name_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Full Name"
                android:textColor="@color/white"
                android:textColorHint="@color/cream_light"
                android:background="@drawable/input_bg"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/phone_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Phone Number"
                android:inputType="phone"
                android:textColor="@color/white"
                android:textColorHint="@color/cream_light"
                android:background="@drawable/input_bg"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/address_input"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:hint="Delivery Address"
                android:gravity="top"
                android:textColor="@color/white"
                android:textColorHint="@color/cream_light"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:layout_marginBottom="18dp" />

            <!-- ORDER TOTAL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/card_gold_border"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Order Total"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/header_green" />

                <TextView
                    android:id="@+id/total_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₦0"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/header_green" />

            </LinearLayout>

            <!-- BANK TRANSFER HEADING -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏦 BANK TRANSFER PAYMENT"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gold"
                android:layout_marginBottom="10dp" />

            <!-- IYAADAM KITCHEN PAYMENT CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_gold_border"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IYAADAM KITCHEN"
                    android:textColor="@color/header_green"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="5dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Official Bank Transfer Account"
                    android:textColor="@color/header_green"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingBottom="18dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#C9A746"
                    android:layout_marginBottom="15dp" />

                <!-- BANK NAME -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BANK NAME"
                    android:textStyle="bold"
                    android:textColor="@color/header_green"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/bank_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MONIEPOINT MICROFINANCE BANK"
                    android:textStyle="bold"
                    android:textColor="@color/header_green"
                    android:textSize="17sp"
                    android:layout_marginBottom="14dp" />

                <!-- ACCOUNT NAME -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ACCOUNT NAME"
                    android:textStyle="bold"
                    android:textColor="@color/header_green"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/account_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ABIBAT YUSUF"
                    android:textColor="@color/header_green"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:layout_marginBottom="14dp" />

                <!-- ACCOUNT NUMBER -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ACCOUNT NUMBER"
                    android:textStyle="bold"
                    android:textColor="@color/header_green"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/account_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="55dp"
                    android:text="5258217689"
                    android:textStyle="bold"
                    android:textColor="#002D21"
                    android:textSize="28sp"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:includeFontPadding="true"
                    android:singleLine="true"
                    android:textIsSelectable="true"
                    android:paddingTop="6dp"
                    android:paddingBottom="15dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#C9A746"
                    android:layout_marginBottom="13dp" />

                <!-- PAYMENT INSTRUCTION -->

                <TextView
                    android:id="@+id/payment_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Please transfer the exact order amount to this account before submitting your order."
                    android:textColor="@color/header_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- CUSTOMER INSTRUCTION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="After making your transfer, tap the button below to submit your order. Your order details will be sent to IyaAdam Kitchen through WhatsApp."
                android:textColor="@color/cream_light"
                android:textSize="13sp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>

    </ScrollView>

    <!-- SUBMIT ORDER BUTTON -->

    <Button
        android:id="@+id/pay_btn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="I've Made the Transfer ✓"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/header_green"
        android:background="@color/gold"
        android:layout_marginTop="12dp" />

</LinearLayout>

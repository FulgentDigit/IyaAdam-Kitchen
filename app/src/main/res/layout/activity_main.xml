<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#06452F">

    <!-- ELEGANT HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#06452F"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IyaAdam Kitchen"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/gold"
            android:textAlignment="center"
            android:fontFamily="serif"
            android:shadowColor="@color/black"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visit IyaAdam Kitchen @ Awokoya, Ijebu Ode for delicious experience"
            android:textSize="9sp"
            android:textColor="@color/cream_light"
            android:textAlignment="center"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.01" />
    </LinearLayout>

    <!-- RED & WHITE RIBBON -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/alert_red" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white" />

    <!-- HERO SECTION (REDUCED) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:src="@drawable/images"
        android:scaleType="centerCrop"
        android:contentDescription="Hero Image" />

    <!-- RED & WHITE RIBBON -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white" />

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/alert_red" />

    <!-- CATEGORIES (COMPACT & VISIBLE) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#06452F"
        android:scrollbars="none"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/card_white_rounded">
                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="45dp"
                    android:src="@drawable/images"
                    android:scaleType="centerCrop" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="African"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/header_green"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/card_white_rounded">
                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="45dp"
                    android:src="@drawable/images8"
                    android:scaleType="centerCrop" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continental"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/header_green"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/card_white_rounded">
                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="45dp"
                    android:src="@drawable/images10"
                    android:scaleType="centerCrop" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grills"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/header_green"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/card_white_rounded">
                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="45dp"
                    android:src="@drawable/images11"
                    android:scaleType="centerCrop" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rice"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="@color/header_green"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- RED & WHITE RIBBON -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/alert_red" />

    <!-- FEATURED TITLE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        android:background="#06452F">

        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="@color/alert_red"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Featured Dishes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/gold" />

    </LinearLayout>

    <!-- DISHES RECYCLER -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dishes_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:background="#06452F" />

    <!-- RED & WHITE RIBBON -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/alert_red" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white" />

    <!-- FOOTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#06452F"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/ic_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="12sp"
                android:textColor="@color/gold"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/ic_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu"
                android:textSize="12sp"
                android:textColor="@color/gold"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/ic_cart_nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cart"
                android:textSize="12sp"
                android:textColor="@color/gold"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/ic_orders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Orders"
                android:textSize="12sp"
                android:textColor="@color/gold"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView
                android:id="@+id/ic_person"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="12sp"
                android:textColor="@color/gold"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- CREDIT -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="fdc: +2347089364492"
        android:textSize="9sp"
        android:textColor="@color/gold"
        android:textAlignment="center"
        android:paddingVertical="8dp"
        android:background="#06452F"
        android:letterSpacing="0.01" />

</LinearLayout>

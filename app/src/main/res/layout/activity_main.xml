<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F0">

    <!-- MAIN HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#002D21">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IyaAdam Kitchen"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home of African &amp; Continental Dishes"
                android:textColor="#E8CA63"
                android:textSize="10sp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/ic_notification"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_popup_reminder"
            android:tint="#E8CA63"
            android:contentDescription="Notifications"/>

        <ImageView
            android:id="@+id/ic_cart_header"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="14dp"
            android:src="@android:drawable/ic_menu_add"
            android:tint="#E8CA63"
            android:contentDescription="Shopping cart"/>
    </LinearLayout>

    <!-- SCROLLABLE MAIN CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- HERO FOOD IMAGE -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_margin="14dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/pounded_yam_and_dry_fish"
                    android:scaleType="centerCrop"
                    android:contentDescription="Pounded yam and dry fish"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:padding="18dp"
                    android:background="#66000000">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DELICIOUS MEALS, MADE WITH LOVE"
                        android:textColor="#E8CA63"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Taste the Goodness of Home"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btn_order_now"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:text="ORDER NOW"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:backgroundTint="#06452F"/>
                </LinearLayout>
            </FrameLayout>

            <!-- WELCOME SECTION -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="#F4E7D0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to IyaAdam Kitchen"
                    android:textColor="#002D21"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Enjoy freshly prepared African and Continental dishes, made with love and served with excellence."
                    android:textColor="#555555"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- FOOD CATEGORIES -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:text="EXPLORE OUR MENU"
                android:textColor="#002D21"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <!-- AFRICAN -->

                    <LinearLayout
                        android:layout_width="130dp"
                        android:layout_height="125dp"
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_marginEnd="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="85dp"
                            android:src="@drawable/amarla_with_ewedu"
                            android:scaleType="centerCrop"
                            android:contentDescription="Amala with ewedu"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="5dp"
                            android:text="African"
                            android:textColor="#002D21"
                            android:textStyle="bold"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- CONTINENTAL -->

                    <LinearLayout
                        android:layout_width="130dp"
                        android:layout_height="125dp"
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_marginEnd="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="85dp"
                            android:src="@drawable/rice_and_egg"
                            android:scaleType="centerCrop"
                            android:contentDescription="Rice and egg"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="5dp"
                            android:text="Continental"
                            android:textColor="#002D21"
                            android:textStyle="bold"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- GRILLS -->

                    <LinearLayout
                        android:layout_width="130dp"
                        android:layout_height="125dp"
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_marginEnd="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="85dp"
                            android:src="@drawable/goat_meat_pepper_soup"
                            android:scaleType="centerCrop"
                            android:contentDescription="Goat meat pepper soup"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="5dp"
                            android:text="Grills"
                            android:textColor="#002D21"
                            android:textStyle="bold"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- RICE DISHES -->

                    <LinearLayout
                        android:layout_width="130dp"
                        android:layout_height="125dp"
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_marginEnd="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="85dp"
                            android:src="@drawable/vegetable_rice_with_boiled_eggs"
                            android:scaleType="centerCrop"
                            android:contentDescription="Vegetable rice with boiled eggs"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="5dp"
                            android:text="Rice Dishes"
                            android:textColor="#002D21"
                            android:textStyle="bold"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- SOUPS -->

                    <LinearLayout
                        android:layout_width="130dp"
                        android:layout_height="125dp"
                        android:orientation="vertical"
                        android:padding="5dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="85dp"
                            android:src="@drawable/egusi_soup_with_assorted_meat_and_fish"
                            android:scaleType="centerCrop"
                            android:contentDescription="Egusi soup with assorted meat and fish"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="5dp"
                            android:text="Soups &amp; Stews"
                            android:textColor="#002D21"
                            android:textStyle="bold"
                            android:textSize="13sp"/>
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- FEATURED DISHES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Featured Dishes"
                    android:textColor="#002D21"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btn_view_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All"
                    android:textColor="#B87924"
                    android:textStyle="bold"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- EXISTING MENU RECYCLER VIEW -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dishes_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:nestedScrollingEnabled="false"/>

            <!-- LOCATION -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="18dp"
                android:layout_marginTop="15dp"
                android:background="#002D21">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VISIT IYAADAM KITCHEN"
                    android:textColor="#E8CA63"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Awokoya, Ijebu Ode, Ogun State"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <TextView
            android:id="@+id/ic_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Home"
            android:textColor="#06452F"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/ic_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌕&#10;Search"
            android:textColor="#666666"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/ic_cart_nav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🛒&#10;Cart"
            android:textColor="#666666"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/ic_orders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="☰&#10;Orders"
            android:textColor="#666666"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/ic_person"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="●&#10;Profile"
            android:textColor="#666666"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- FOOTER CREDIT -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:gravity="center"
        android:background="#002D21"
        android:text="Powered by Fulgent Digital"
        android:textColor="#E8CA63"
        android:textSize="10sp"/>

</LinearLayout>

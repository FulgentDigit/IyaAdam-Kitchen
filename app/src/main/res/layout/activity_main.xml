<?xml version="1.0" encoding="utf-8"?><LinearLayout
xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:background="#002D21">

<!-- =========================
     PREMIUM HEADER
     ========================= -->

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp"
    android:background="@drawable/header_gradient">

    <!-- TOP ROW -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- BRAND -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="👨🏾‍🍳"
                android:textSize="25sp"
                android:background="@drawable/logo_circle"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IyaAdam"
                    android:textColor="@color/gold"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="3"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="K I T C H E N"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"/>

            </LinearLayout>

        </LinearLayout>


        <!-- NOTIFICATION -->

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:background="@drawable/icon_circle">

            <TextView
                android:id="@+id/ic_notification"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🔔"
                android:textSize="21sp"/>

            <TextView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/badge_red"/>

        </FrameLayout>


        <!-- CART -->

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:background="@drawable/icon_circle">

            <TextView
                android:id="@+id/ic_cart_header"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🛒"
                android:textSize="21sp"/>

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/badge_red"/>

        </FrameLayout>

    </LinearLayout>


    <!-- TAGLINE -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="Home of African and Continental Dishes"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"/>


    <!-- LOCATION -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="📍 Awokoya, Ijebu Ode, Ogun State"
        android:textColor="#D9E9E1"
        android:textSize="10sp"/>

</LinearLayout>


<!-- RED SEPARATOR -->

<View
    android:layout_width="match_parent"
    android:layout_height="3dp"
    android:background="@color/alert_red"/>


<!-- =========================
     HERO SECTION
     ========================= -->

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="175dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/images"
        android:scaleType="centerCrop"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_overlay"/>


    <!-- HERO CONTENT -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTHENTIC"
            android:textColor="@color/gold"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"/>

        <TextView
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="African &amp; Continental Meals"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="serif"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Freshly prepared • Great taste • Served with love"
            android:textColor="#F4F4F4"
            android:textSize="10sp"/>


        <!-- ORDER BUTTON -->

        <TextView
            android:id="@+id/btn_order_now"
            android:layout_width="130dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="ORDER NOW  →"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/order_button"/>

    </LinearLayout>

</FrameLayout>


<!-- =========================
     CATEGORY AREA
     ========================= -->

<HorizontalScrollView
    android:layout_width="match_parent"
    android:layout_height="94dp"
    android:background="#FFFFFF"
    android:scrollbars="none"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">


        <!-- AFRICAN -->

        <LinearLayout
            android:layout_width="92dp"
            android:layout_height="80dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/category_card">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="47dp"
                android:src="@drawable/images"
                android:scaleType="centerCrop"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="African"
                android:textColor="@color/header_green"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

        </LinearLayout>


        <!-- CONTINENTAL -->

        <LinearLayout
            android:layout_width="92dp"
            android:layout_height="80dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/category_card">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="47dp"
                android:src="@drawable/images8"
                android:scaleType="centerCrop"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continental"
                android:textColor="@color/header_green"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

        </LinearLayout>


        <!-- GRILLS -->

        <LinearLayout
            android:layout_width="92dp"
            android:layout_height="80dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/category_card">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="47dp"
                android:src="@drawable/images10"
                android:scaleType="centerCrop"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grills"
                android:textColor="@color/header_green"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

        </LinearLayout>


        <!-- RICE -->

        <LinearLayout
            android:layout_width="92dp"
            android:layout_height="80dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/category_card">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="47dp"
                android:src="@drawable/images11"
                android:scaleType="centerCrop"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rice Dishes"
                android:textColor="@color/header_green"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

        </LinearLayout>


        <!-- SOUPS -->

        <LinearLayout
            android:layout_width="92dp"
            android:layout_height="80dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/category_card">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="47dp"
                android:src="@drawable/images"
                android:scaleType="centerCrop"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soups &amp; Stews"
                android:textColor="@color/header_green"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

    </LinearLayout>

</HorizontalScrollView>


<!-- =========================
     FEATURED TITLE
     ========================= -->

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="17dp"
    android:paddingEnd="17dp"
    android:background="#002D21">

    <View
        android:layout_width="6dp"
        android:layout_height="27dp"
        android:background="@drawable/gold_pill"/>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:text="Featured Dishes"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/btn_view_all"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:text="View All  ›"
        android:textColor="@color/gold"
        android:textSize="12sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>


<!-- =========================
     FEATURED DISHES
     ========================= -->

<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/dishes_recycler"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp"
    android:clipToPadding="false"
    android:background="#002D21"/>


<!-- =========================
     BOTTOM NAVIGATION
     ========================= -->

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bottom_nav"
    android:elevation="12dp">


    <TextView
        android:id="@+id/ic_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="⌂\nHOME"
        android:textColor="@color/gold"
        android:textSize="11sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"/>


    <TextView
        android:id="@+id/ic_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="🍴\nMENU"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"/>


    <!-- CENTER CART -->

    <FrameLayout
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginTop="-18dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/cart_circle">

        <TextView
            android:id="@+id/ic_cart_nav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🛒"
            android:textSize="24sp"/>

    </FrameLayout>


    <TextView
        android:id="@+id/ic_orders"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="♫\nMUSIC"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"/>


    <TextView
        android:id="@+id/ic_person"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="●\nPROFILE"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>


<!-- =========================
     CREDIT / PHONE
     ========================= -->

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="#002D21">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Developed by fdc  •  "
        android:textColor="#D8E7DF"
        android:textSize="9sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+234 708 936 4492"
        android:textColor="@color/gold"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"/>

</LinearLayout>

</LinearLayout>

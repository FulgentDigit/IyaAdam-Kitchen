<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="@color/white">

    <!-- DISH IMAGE -->
    <ImageView
        android:id="@+id/dish_image"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:scaleType="centerCrop"
        android:background="@color/cream_dark"
        android:contentDescription="Dish image" />

    <!-- DETAILS -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dish_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dish Name"
            android:textColor="@color/header_green"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2" />

        <TextView
            android:id="@+id/dish_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="₦2,500"
            android:textColor="@color/alert_red"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- QUANTITY -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_decrease"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="−"
                android:textSize="18sp"
                android:textColor="@color/header_green"
                android:background="@color/gold" />

            <TextView
                android:id="@+id/quantity"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/header_green"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@color/cream_light" />

            <Button
                android:id="@+id/btn_increase"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="+"
                android:textSize="18sp"
                android:textColor="@color/header_green"
                android:background="@color/gold" />

        </LinearLayout>

    </LinearLayout>

    <!-- RIGHT SIDE -->
    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/subtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₦2,500"
            android:textColor="@color/header_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_remove"
            android:layout_width="68dp"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="REMOVE"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@color/alert_red" />

    </LinearLayout>

</LinearLayout>

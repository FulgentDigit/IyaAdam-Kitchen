<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="8dp"
    android:background="#06452F"
    android:elevation="5dp">

    <!-- Food image -->
    <ImageView
        android:id="@+id/dish_image"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:background="#002D21"
        android:contentDescription="Food image" />

    <!-- Dish information -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/dish_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dish Name"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/dish_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delicious freshly prepared meal"
            android:textSize="12sp"
            android:textColor="#D5E4DC"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="5dp" />

        <!-- Rating and preparation time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/rating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="4.5 ⭐ (42)"
                android:textSize="11sp"
                android:textColor="#F2C75C" />

            <TextView
                android:id="@+id/prep_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20 mins"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:paddingStart="8dp"
                android:paddingEnd="4dp" />

        </LinearLayout>

        <!-- Price and cart button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dish_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₦2,500"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#F2C75C" />

            <Button
                android:id="@+id/btn_add_to_cart"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:text="+ Add"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#D4AF37"
                android:textColor="#002D21"
                android:padding="4dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
